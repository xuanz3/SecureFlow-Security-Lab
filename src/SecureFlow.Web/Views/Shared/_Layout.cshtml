<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecureFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a class="brand" asp-controller="Home" asp-action="Index">SecureFlow</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer>
        <span>Authorised local security lab</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
