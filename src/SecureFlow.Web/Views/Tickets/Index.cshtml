@model IReadOnlyCollection<SecureFlow.Web.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
}
<div class="actions">
    <h1>Tickets</h1>
    <a class="button" asp-action="Create">Create ticket</a>
</div>

@if (Model.Count == 0)
{
    <div class="panel"><p>No tickets are visible to this identity.</p></div>
}
else
{
    <table>
        <thead>
            <tr><th>Title</th><th>Status</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Title</td>
                <td>@ticket.Status</td>
                <td>@ticket.CreatedAtUtc.ToString("u")</td>
                <td><a asp-action="Details" asp-route-id="@ticket.Id">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
}
