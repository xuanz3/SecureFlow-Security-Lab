@model SecureFlow.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="panel">
    <h1>Sign in</h1>
    <p>Use one of the fictional local development identities generated by the setup script.</p>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>
        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <label>
            <input asp-for="RememberMe" />
            Remember this local session
        </label>
        <button type="submit">Sign in</button>
    </form>
</div>
